{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "outDir": "./prisma/dist",
    "rootDir": "./prisma",
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["prisma/seed.ts"]
}
